# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.

# The one shared password teammates type in at the login screen.
APP_PASSWORD=change-me-to-a-real-shared-password

# Random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- Getting past KASADA on the VPS: two mutually exclusive options ---
# realestate.com.au's KASADA bot-protection hard-blocks datacenter IPs
# outright (confirmed: even the homepage never clears from a DigitalOcean
# IP), independent of browser fingerprint quality. Leave BOTH unset for
# local installs — each teammate's home/office IP is fine as-is.

# Option A — scraping-unlocker API (ScraperAPI/ZenRows/ScrapingBee): they run
# their own anti-bot-bypass infra, we just call their HTTP API instead of
# launching our own browser. If SCRAPE_API_KEY is set, this is used and
# SCRAPE_PROXY below is ignored.
SCRAPE_API_KEY=
SCRAPE_API_PROVIDER=scraperapi

# Option B — residential proxy: we keep launching our own Chrome/nodriver,
# just routed through a residential exit IP. Format:
#   http://username:password@host:port
SCRAPE_PROXY=
